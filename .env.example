# Use a NEW database owned by TeenCleanPressureWash.
# Never reuse another business's credentials or integration endpoints.
DATABASE_URL=
# Login is off by default. Anyone with the site URL can view and edit records.
# To restore Google login later, set REQUIRE_LOGIN=true and fill the two Google/owner values.
REQUIRE_LOGIN=
GOOGLE_CLIENT_ID=
AUTH_OWNER_CODE=

# Optional spreadsheet integration. Keep blank to use the database only.
SHEETS_SYNC_URL=
SHEETS_SYNC_TOKEN=
VITE_JOBS_SHEET_URL=

# Optional map key for TeenCleanPressureWash's own Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=

PORT=4173
